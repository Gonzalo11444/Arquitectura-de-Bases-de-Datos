<</AP<</N 930 0 R >>/DA(/Georgia 10 Tf 0 g)/F 4/FT/Tx/Ff 33558528/MK<</BC[ 0 0 0]>>/P 40 0 R /RV(\(Empleamos los CREATE INDEX necesarios...\)\r\nSELECT \(COUNT\(DISTINCT c.clienteid\) * 100.0 / \(SELECT COUNT\(*\) FROM clientes\)\) AS porcentaje_clientes_andalucia FROM clientes c JOIN reservas r ON c.clienteid = r.clienteid_clientes  \r\nJOIN vehiculos v ON r.vehiculoid_vehiculos = v.vehiculoid  JOIN plazas p ON r.plazaid_plazas = p.plazaid  JOIN pagos p2 ON r.reservaid = p2.reservaid_reservas  LEFT JOIN  incidencias i ON r.reservaid = i.reservaid_reservas  \r\nWHERE  c.provincia IN \('Almería', 'Cádiz', 'Córdoba', 'Granada', 'Huelva', 'Jaén', 'Málaga','Sevilla'\) AND EXTRACT\(MONTH FROM r.fechainicio\) IN \(6, 7, 8\)  AND p2.cantidad > 150  AND p.numero < -4  AND \(i.estado != 'cerrada' OR i.estado IS NULL\)  AND v.color != 'negro';\r\nporcentaje_clientes_andalucia\r\n-------------------------------\r\n            4.4182666666666667\r\nDuración: 131984,519 ms \(02:11,985\))/Rect[ 84.497101 289.522 545.93201 460.42001]/Subtype/Widget/T(Text14)/Type/Annot/V(\(Empleamos los CREATE INDEX necesarios...\)\r\nSELECT \(COUNT\(DISTINCT c.clienteid\) * 100.0 / \(SELECT COUNT\(*\) FROM clientes\)\) AS porcentaje_clientes_andalucia FROM clientes c JOIN reservas r ON c.clienteid = r.clienteid_clientes  \r\nJOIN vehiculos v ON r.vehiculoid_vehiculos = v.vehiculoid  JOIN plazas p ON r.plazaid_plazas = p.plazaid  JOIN pagos p2 ON r.reservaid = p2.reservaid_reservas  LEFT JOIN  incidencias i ON r.reservaid = i.reservaid_reservas  \r\nWHERE  c.provincia IN \('Almería', 'Cádiz', 'Córdoba', 'Granada', 'Huelva', 'Jaén', 'Málaga','Sevilla'\) AND EXTRACT\(MONTH FROM r.fechainicio\) IN \(6, 7, 8\)  AND p2.cantidad > 150  AND p.numero < -4  AND \(i.estado != 'cerrada' OR i.estado IS NULL\)  AND v.color != 'negro';\r\nporcentaje_clientes_andalucia\r\n-------------------------------\r\n            4.4182666666666667\r\nDuración: 131984,519 ms \(02:11,985\))>>

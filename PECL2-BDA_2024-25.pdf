<</AP<</N 877 0 R >>/DA(/Georgia 10 Tf 0 g)/F 4/FT/Tx/Ff 33558528/MK<<>>/P 31 0 R /RV(No entra todo el codigo, pero:\r\nimport random\r\nimport csv\r\nfrom datetime import datetime, timedelta\r\n\r\n# Configuración\r\nrandom.seed\(42\)  # Para reproducibilidad\r\nNUM_CLIENTES = 3_000_000\r\nNUM_VEHICULOS = 5_000_000\r\nNUM_PLAZAS = 200_000\r\nNUM_RESERVAS = 40_000_000\r\nNUM_INCIDENCIAS = 4_000_000\r\n\r\n# Datos de referencia\r\nPROVINCIAS_ESPANOLAS = ['Álava', 'Albacete', 'Alicante', 'Almería', 'Asturias', 'Ávila', 'Badajoz', \r\n                       'Baleares', 'Barcelona', 'Burgos', 'Cáceres', 'Cádiz', 'Cantabria', \r\n                       'Castellón', 'Ciudad Real', 'Córdoba', 'Cuenca', 'Gerona', 'Granada', \r\n                       'Guadalajara', 'Guipúzcoa', 'Huelva', 'Huesca', 'Jaén', 'La Coruña', \r\n                       'La Rioja', 'Las Palmas', 'León', 'Lérida', 'Lugo', 'Madrid', 'Málaga', \r\n                       'Murcia', 'Navarra', 'Orense', 'Palencia', 'Pontevedra', 'Salamanca', \r\n                       'Santa Cruz de Tenerife', 'Segovia', 'Sevilla', 'Soria', 'Tarragona', \r\n                       'Teruel', 'Toledo', 'Valencia', 'Valladolid', 'Vizcaya', 'Zamora', 'Zaragoza']\r\n\r\nMETODOS_PAGO = ['efectivo', 'tarjeta crédito', 'tarjeta débito', 'PayPal', 'Bizzum', 'transferencia']\r\nESTADOS_INCIDENCIA = ['nueva', 'abierta', 'en proceso', 'resuelta', 'cerrada']\r\nSECCIONES_PARKING = ['A', 'B', 'C', 'D', 'E', 'F']\r\n\r\n# Generar marcas y modelos de vehículos\r\nMARCAS_VEHICULOS = [f"Marca_{i}" for i in range\(1, 501\)]\r\nMODELOS_POR_MARCA = {marca: [f"Modelo_{i}" for i in range\(1, random.randint\(5, 21\)\)] for marca in MARCAS_VEHICULOS}\r\nCOLORES = ['negro'] + [f"color_{i}" for i in range\(1, 15\)]\r\n\r\ndef generar_fecha_aleatoria\(año=2024\):\r\n    """Genera una fecha aleatoria en el año especificado"""\r\n    mes = random.randint\(1, 12\)\r\n    dia = random.randint\(1, 28\)  # Evitamos problemas con febrero\r\n    hora = random.randint\(0, 23\)\r\n    minuto = random.randint\(0, 59\)\r\n    return datetime\(año, mes, dia, hora, minuto\)\r\n\r\ndef generar_duracion_estancia\(\):\r\n    """Genera una duración de estancia entre 1 y 10 días"""\r\n    return random.randint\(1, 10\)\r\n\r\ndef generar_clientes\(\):\r\n    """Genera datos de clientes"""\r\n    print\("Generando clientes..."\)\r\n    with open\('Clientes.csv', 'w', newline=''\) as f:\r\n        writer = csv.writer\(f\)\r\n        writer.writerow\(['id', 'nombre', 'apellidos', 'email', 'telefono','provincia']\)\r\n        \r\n        for i in range\(1, NUM_CLIENTES + 1\):\r\n            id = i\r\n            nombre = f"Cliente_{i}"\r\n            apellidos = f"Apellido1_{i} Apellido2_{i}"\r\n            email = f"cliente{i}@example.com"\r\n            telefono = i\r\n            provincia = random.choice\(PROVINCIAS_ESPANOLAS\)\r\n            writer.writerow\([id, nombre, apellidos, email, telefono,provincia]\)\r\n    print\(f"Generados {NUM_CLIENTES} clientes"\)\r\n\r\n# Datos de referencia \(mantenemos tus configuraciones originales\)\r\nMARCAS_VEHICULOS = [f"Marca_{i}" for i in range\(1, 501\)]\r\nMODELOS_POR_MARCA = {marca: [f"Modelo_{i}" for i in range\(1, random.randint\(5, 21\)\)] for marca in MARCAS_VEHICULOS}\r\nCOLORES = ['negro'] + [f"color_{i}" for i in range\(1, 15\)]\r\nLETRAS_MATRICULA = 'BCDFGHJKLMNPRSTVWXYZ'  # Letras válidas para matrículas españolas\r\n\r\ndef generar_matricula_unica\(existentes\):\r\n    """Genera una matrícula única que no existe en el conjunto proporcionado"""\r\n    while True:\r\n        # Formato: 1234ABC \(4 números + 3 letras\)\r\n        numeros = f"{random.randint\(1000, 9999\)}"\r\n        letras = f"{random.choice\(LETRAS_MATRICULA\)}{random.choice\(LETRAS_MATRICULA\)}{random.choice\(LETRAS_MATRICULA\)}"\r\n        matricula = f"{numeros}{letras}"\r\n        \r\n        if matricula not in existentes:\r\n            existentes.add\(matricula\)\r\n            return matricula\r\n\r\ndef generar_vehiculos\(\):\r\n    """Genera datos de vehículos garantizando matrículas únicas"""\r\n    print\("Generando vehículos con matrículas únicas..."\)\r\n    matriculas_unicas = set\(\)  # Almacena todas las matrículas generadas\r\n    \r\n    with open\('Vehiculos.csv', 'w', newline='', encoding='utf-8'\) as f:\r\n        writer = csv.writer\(f\)\r\n        writer.writerow\(['id', 'matricula', 'marca', 'modelo', 'color', 'cliente_id']\)\r\n        \r\n        for i in range\(1, NUM_VEHICULOS + 1\):\r\n            if i % 100000 == 0:  # Mostrar progreso cada 100k registros\r\n                print\(f"Progreso: {i}/{NUM_VEHICULOS} vehículos generados"\)\r\n            \r\n            # Generar matrícula única\r\n            matricula = generar_matricula_unica\(matriculas_unicas\)\r\n            \r\n            # Generar resto de datos\r\n            marca = random.choice\(MARCAS_VEHICULOS\)\r\n            modelo = random.choice\(MODELOS_POR_MARCA[marca]\)\r\n            color = random.choice\(COLORES\)\r\n            cliente_id = random.randint\(1, 3_000_000\)  # Asume 3M clientes\r\n            \r\n            writer.writerow\([\r\n                i,          # id\r\n                matricula,  # matrícula única\r\n                marca,\r\n                modelo,\r\n                color,\r\n                cliente_id\r\n            ]\)\r\n    \r\n    print\(f"Generados {NUM_VEHICULOS} vehículos con matrículas únicas"\)\r\n\r\n\r\ndef generar_plazas_parking\(\):\r\n    """Genera datos de plazas de parking"""\r\n    print\("Generando plazas de parking..."\)\r\n    with open\('Plazas_Parking.csv', 'w', newline=''\) as f:\r\n        writer = csv.writer\(f\)\r\n        writer.writerow\(['id', 'planta', 'seccion', 'numero']\)\r\n        \r\n        for i in range\(1, NUM_PLAZAS + 1\):\r\n            id = i\r\n            planta = random.randint\(-10, 0\)\r\n            seccion = random.choice\(SECCIONES_PARKING\)\r\n            numero = random.randint\(1, 999\)\r\n            writer.writerow\([id, planta, seccion, numero]\)\r\n    print\(f"Generados {NUM_PLAZAS} plazas de parking"\)\r\n\r\n\r\ndef generar_reservas_y_pagos\(\):\r\n    """Genera datos de reservas y pagos en archivos separados"""\r\n    print\("Generando reservas y pagos..."\)\r\n    \r\n    # Abrir ambos archivos simultáneamente\r\n    with open\('reservas.csv', 'w', newline=''\) as f_reservas, \\\r\n         open\('pagos.csv', 'w', newline=''\) as f_pagos:\r\n        \r\n        # Configurar writers para cada archivo\r\n        writer_reservas = csv.writer\(f_reservas\)\r\n        writer_pagos = csv.writer\(f_pagos\)\r\n        \r\n        # Escribir headers personalizados para cada archivo\r\n        writer_reservas.writerow\(['id', 'fecha_inicio', 'fecha_fin', 'plaza_id', 'vehiculo_id', 'cliente_id']\)\r\n        writer_pagos.writerow\(['id', 'reserva_id', 'importe', 'metodo_pago', 'fecha_pago']\)\r\n        \r\n        for i in range\(1, NUM_RESERVAS + 1\):\r\n            if i % 1_000_000 == 0:\r\n                print\(f"Progreso: {i}/{NUM_RESERVAS} registros generados"\)\r\n            \r\n            # Generar datos comunes\r\n            id = i\r\n            fecha_inicio = generar_fecha_aleatoria\(\)\r\n            duracion = generar_duracion_estancia\(\)\r\n            fecha_fin = fecha_inicio + timedelta\(days=duracion\)\r\n            horas = duracion * 24\r\n            importe = horas * 3\r\n            dias_antes = random.randint\(1, 30\)\r\n            fecha_pago = fecha_inicio - timedelta\(days=dias_antes\)\r\n            \r\n            # Escribir en reservas.csv \(solo datos de reserva\)\r\n            writer_reservas.writerow\([\r\n                id,  # id\r\n                fecha_inicio.strftime\('%Y-%m-%d %H:%M:%S'\),\r\n                fecha_fin.strftime\('%Y-%m-%d %H:%M:%S'\),\r\n                random.randint\(1, NUM_PLAZAS\),  # plaza_id\r\n                random.randint\(1, NUM_VEHICULOS\),  # vehiculo_id\r\n                random.randint\(1, NUM_CLIENTES\)  # cliente_id\r\n            ]\)\r\n            \r\n            # Escribir en pagos.csv \(solo datos de pago\)\r\n            writer_pagos.writerow\([\r\n                id,  # id del pago\r\n                id,  # reserva_id \(mismo id que la reserva\)\r\n                f"{importe:.2f}",\r\n                random.choice\(METODOS_PAGO\),\r\n                fecha_pago.strftime\('%Y-%m-%d %H:%M:%S'\)\r\n            ]\)\r\n    \r\n    print\(f"Generados {NUM_RESERVAS} registros en reservas.csv"\)\r\n    print\(f"Generados {NUM_RESERVAS} registros en pagos.csv"\)\r\n\r\ndef generar_incidencias\(\):\r\n    """Genera datos de incidencias"""\r\n    print\("Generando incidencias..."\)\r\n    with open\('Incidencias.csv', 'w', newline=''\) as f:\r\n        writer = csv.writer\(f\)\r\n        writer.writerow\(['id', 'reserva_id', 'descripcion', 'estado', 'fecha_creacion']\)\r\n        \r\n        # Seleccionar reservas aleatorias para incidencias \(sin repetición\)\r\n        reservas_con_incidencia = random.sample\(range\(1, NUM_RESERVAS + 1\), NUM_INCIDENCIAS\)\r\n        \r\n        for i, reserva_id in enumerate\(reservas_con_incidencia, 1\):\r\n            id = i\r\n            descripcion = f"Incidencia {i} en reserva {reserva_id}"\r\n            estado = random.choice\(ESTADOS_INCIDENCIA\)\r\n            fecha_creacion = generar_fecha_aleatoria\(\)\r\n            writer.writerow\([\r\n                id,\r\n                reserva_id,\r\n                descripcion,\r\n                estado,\r\n                fecha_creacion.strftime\('%Y-%m-%d %H:%M:%S'\)\r\n            ]\)\r\n    print\(f"Generados {NUM_INCIDENCIAS} incidencias"\)\r\n\r\ndef main\(\):\r\n    """Función principal que genera todos los datos"""\r\n    print\("Iniciando generación de datos para TELPARK"\)\r\n    generar_clientes\(\)\r\n    generar_vehiculos\(\)\r\n    generar_plazas_parking\(\)\r\n    generar_reservas_y_pagos\(\)  \r\n    generar_incidencias\(\)\r\n    print\("Generación de datos completada"\)\r\n\r\nif __name__ == "__main__":\r\n    main\(\))/Rect[ 80.793404 425.142 543.646 692.513]/Subtype/Widget/T(Text9)/Type/Annot/V(No entra todo el codigo, pero:\r\nimport random\r\nimport csv\r\nfrom datetime import datetime, timedelta\r\n\r\n# Configuración\r\nrandom.seed\(42\)  # Para reproducibilidad\r\nNUM_CLIENTES = 3_000_000\r\nNUM_VEHICULOS = 5_000_000\r\nNUM_PLAZAS = 200_000\r\nNUM_RESERVAS = 40_000_000\r\nNUM_INCIDENCIAS = 4_000_000\r\n\r\n# Datos de referencia\r\nPROVINCIAS_ESPANOLAS = ['Álava', 'Albacete', 'Alicante', 'Almería', 'Asturias', 'Ávila', 'Badajoz', \r\n                       'Baleares', 'Barcelona', 'Burgos', 'Cáceres', 'Cádiz', 'Cantabria', \r\n                       'Castellón', 'Ciudad Real', 'Córdoba', 'Cuenca', 'Gerona', 'Granada', \r\n                       'Guadalajara', 'Guipúzcoa', 'Huelva', 'Huesca', 'Jaén', 'La Coruña', \r\n                       'La Rioja', 'Las Palmas', 'León', 'Lérida', 'Lugo', 'Madrid', 'Málaga', \r\n                       'Murcia', 'Navarra', 'Orense', 'Palencia', 'Pontevedra', 'Salamanca', \r\n                       'Santa Cruz de Tenerife', 'Segovia', 'Sevilla', 'Soria', 'Tarragona', \r\n                       'Teruel', 'Toledo', 'Valencia', 'Valladolid', 'Vizcaya', 'Zamora', 'Zaragoza']\r\n\r\nMETODOS_PAGO = ['efectivo', 'tarjeta crédito', 'tarjeta débito', 'PayPal', 'Bizzum', 'transferencia']\r\nESTADOS_INCIDENCIA = ['nueva', 'abierta', 'en proceso', 'resuelta', 'cerrada']\r\nSECCIONES_PARKING = ['A', 'B', 'C', 'D', 'E', 'F']\r\n\r\n# Generar marcas y modelos de vehículos\r\nMARCAS_VEHICULOS = [f"Marca_{i}" for i in range\(1, 501\)]\r\nMODELOS_POR_MARCA = {marca: [f"Modelo_{i}" for i in range\(1, random.randint\(5, 21\)\)] for marca in MARCAS_VEHICULOS}\r\nCOLORES = ['negro'] + [f"color_{i}" for i in range\(1, 15\)]\r\n\r\ndef generar_fecha_aleatoria\(año=2024\):\r\n    """Genera una fecha aleatoria en el año especificado"""\r\n    mes = random.randint\(1, 12\)\r\n    dia = random.randint\(1, 28\)  # Evitamos problemas con febrero\r\n    hora = random.randint\(0, 23\)\r\n    minuto = random.randint\(0, 59\)\r\n    return datetime\(año, mes, dia, hora, minuto\)\r\n\r\ndef generar_duracion_estancia\(\):\r\n    """Genera una duración de estancia entre 1 y 10 días"""\r\n    return random.randint\(1, 10\)\r\n\r\ndef generar_clientes\(\):\r\n    """Genera datos de clientes"""\r\n    print\("Generando clientes..."\)\r\n    with open\('Clientes.csv', 'w', newline=''\) as f:\r\n        writer = csv.writer\(f\)\r\n        writer.writerow\(['id', 'nombre', 'apellidos', 'email', 'telefono','provincia']\)\r\n        \r\n        for i in range\(1, NUM_CLIENTES + 1\):\r\n            id = i\r\n            nombre = f"Cliente_{i}"\r\n            apellidos = f"Apellido1_{i} Apellido2_{i}"\r\n            email = f"cliente{i}@example.com"\r\n            telefono = i\r\n            provincia = random.choice\(PROVINCIAS_ESPANOLAS\)\r\n            writer.writerow\([id, nombre, apellidos, email, telefono,provincia]\)\r\n    print\(f"Generados {NUM_CLIENTES} clientes"\)\r\n\r\n# Datos de referencia \(mantenemos tus configuraciones originales\)\r\nMARCAS_VEHICULOS = [f"Marca_{i}" for i in range\(1, 501\)]\r\nMODELOS_POR_MARCA = {marca: [f"Modelo_{i}" for i in range\(1, random.randint\(5, 21\)\)] for marca in MARCAS_VEHICULOS}\r\nCOLORES = ['negro'] + [f"color_{i}" for i in range\(1, 15\)]\r\nLETRAS_MATRICULA = 'BCDFGHJKLMNPRSTVWXYZ'  # Letras válidas para matrículas españolas\r\n\r\ndef generar_matricula_unica\(existentes\):\r\n    """Genera una matrícula única que no existe en el conjunto proporcionado"""\r\n    while True:\r\n        # Formato: 1234ABC \(4 números + 3 letras\)\r\n        numeros = f"{random.randint\(1000, 9999\)}"\r\n        letras = f"{random.choice\(LETRAS_MATRICULA\)}{random.choice\(LETRAS_MATRICULA\)}{random.choice\(LETRAS_MATRICULA\)}"\r\n        matricula = f"{numeros}{letras}"\r\n        \r\n        if matricula not in existentes:\r\n            existentes.add\(matricula\)\r\n            return matricula\r\n\r\ndef generar_vehiculos\(\):\r\n    """Genera datos de vehículos garantizando matrículas únicas"""\r\n    print\("Generando vehículos con matrículas únicas..."\)\r\n    matriculas_unicas = set\(\)  # Almacena todas las matrículas generadas\r\n    \r\n    with open\('Vehiculos.csv', 'w', newline='', encoding='utf-8'\) as f:\r\n        writer = csv.writer\(f\)\r\n        writer.writerow\(['id', 'matricula', 'marca', 'modelo', 'color', 'cliente_id']\)\r\n        \r\n        for i in range\(1, NUM_VEHICULOS + 1\):\r\n            if i % 100000 == 0:  # Mostrar progreso cada 100k registros\r\n                print\(f"Progreso: {i}/{NUM_VEHICULOS} vehículos generados"\)\r\n            \r\n            # Generar matrícula única\r\n            matricula = generar_matricula_unica\(matriculas_unicas\)\r\n            \r\n            # Generar resto de datos\r\n            marca = random.choice\(MARCAS_VEHICULOS\)\r\n            modelo = random.choice\(MODELOS_POR_MARCA[marca]\)\r\n            color = random.choice\(COLORES\)\r\n            cliente_id = random.randint\(1, 3_000_000\)  # Asume 3M clientes\r\n            \r\n            writer.writerow\([\r\n                i,          # id\r\n                matricula,  # matrícula única\r\n                marca,\r\n                modelo,\r\n                color,\r\n                cliente_id\r\n            ]\)\r\n    \r\n    print\(f"Generados {NUM_VEHICULOS} vehículos con matrículas únicas"\)\r\n\r\n\r\ndef generar_plazas_parking\(\):\r\n    """Genera datos de plazas de parking"""\r\n    print\("Generando plazas de parking..."\)\r\n    with open\('Plazas_Parking.csv', 'w', newline=''\) as f:\r\n        writer = csv.writer\(f\)\r\n        writer.writerow\(['id', 'planta', 'seccion', 'numero']\)\r\n        \r\n        for i in range\(1, NUM_PLAZAS + 1\):\r\n            id = i\r\n            planta = random.randint\(-10, 0\)\r\n            seccion = random.choice\(SECCIONES_PARKING\)\r\n            numero = random.randint\(1, 999\)\r\n            writer.writerow\([id, planta, seccion, numero]\)\r\n    print\(f"Generados {NUM_PLAZAS} plazas de parking"\)\r\n\r\n\r\ndef generar_reservas_y_pagos\(\):\r\n    """Genera datos de reservas y pagos en archivos separados"""\r\n    print\("Generando reservas y pagos..."\)\r\n    \r\n    # Abrir ambos archivos simultáneamente\r\n    with open\('reservas.csv', 'w', newline=''\) as f_reservas, \\\r\n         open\('pagos.csv', 'w', newline=''\) as f_pagos:\r\n        \r\n        # Configurar writers para cada archivo\r\n        writer_reservas = csv.writer\(f_reservas\)\r\n        writer_pagos = csv.writer\(f_pagos\)\r\n        \r\n        # Escribir headers personalizados para cada archivo\r\n        writer_reservas.writerow\(['id', 'fecha_inicio', 'fecha_fin', 'plaza_id', 'vehiculo_id', 'cliente_id']\)\r\n        writer_pagos.writerow\(['id', 'reserva_id', 'importe', 'metodo_pago', 'fecha_pago']\)\r\n        \r\n        for i in range\(1, NUM_RESERVAS + 1\):\r\n            if i % 1_000_000 == 0:\r\n                print\(f"Progreso: {i}/{NUM_RESERVAS} registros generados"\)\r\n            \r\n            # Generar datos comunes\r\n            id = i\r\n            fecha_inicio = generar_fecha_aleatoria\(\)\r\n            duracion = generar_duracion_estancia\(\)\r\n            fecha_fin = fecha_inicio + timedelta\(days=duracion\)\r\n            horas = duracion * 24\r\n            importe = horas * 3\r\n            dias_antes = random.randint\(1, 30\)\r\n            fecha_pago = fecha_inicio - timedelta\(days=dias_antes\)\r\n            \r\n            # Escribir en reservas.csv \(solo datos de reserva\)\r\n            writer_reservas.writerow\([\r\n                id,  # id\r\n                fecha_inicio.strftime\('%Y-%m-%d %H:%M:%S'\),\r\n                fecha_fin.strftime\('%Y-%m-%d %H:%M:%S'\),\r\n                random.randint\(1, NUM_PLAZAS\),  # plaza_id\r\n                random.randint\(1, NUM_VEHICULOS\),  # vehiculo_id\r\n                random.randint\(1, NUM_CLIENTES\)  # cliente_id\r\n            ]\)\r\n            \r\n            # Escribir en pagos.csv \(solo datos de pago\)\r\n            writer_pagos.writerow\([\r\n                id,  # id del pago\r\n                id,  # reserva_id \(mismo id que la reserva\)\r\n                f"{importe:.2f}",\r\n                random.choice\(METODOS_PAGO\),\r\n                fecha_pago.strftime\('%Y-%m-%d %H:%M:%S'\)\r\n            ]\)\r\n    \r\n    print\(f"Generados {NUM_RESERVAS} registros en reservas.csv"\)\r\n    print\(f"Generados {NUM_RESERVAS} registros en pagos.csv"\)\r\n\r\ndef generar_incidencias\(\):\r\n    """Genera datos de incidencias"""\r\n    print\("Generando incidencias..."\)\r\n    with open\('Incidencias.csv', 'w', newline=''\) as f:\r\n        writer = csv.writer\(f\)\r\n        writer.writerow\(['id', 'reserva_id', 'descripcion', 'estado', 'fecha_creacion']\)\r\n        \r\n        # Seleccionar reservas aleatorias para incidencias \(sin repetición\)\r\n        reservas_con_incidencia = random.sample\(range\(1, NUM_RESERVAS + 1\), NUM_INCIDENCIAS\)\r\n        \r\n        for i, reserva_id in enumerate\(reservas_con_incidencia, 1\):\r\n            id = i\r\n            descripcion = f"Incidencia {i} en reserva {reserva_id}"\r\n            estado = random.choice\(ESTADOS_INCIDENCIA\)\r\n            fecha_creacion = generar_fecha_aleatoria\(\)\r\n            writer.writerow\([\r\n                id,\r\n                reserva_id,\r\n                descripcion,\r\n                estado,\r\n                fecha_creacion.strftime\('%Y-%m-%d %H:%M:%S'\)\r\n            ]\)\r\n    print\(f"Generados {NUM_INCIDENCIAS} incidencias"\)\r\n\r\ndef main\(\):\r\n    """Función principal que genera todos los datos"""\r\n    print\("Iniciando generación de datos para TELPARK"\)\r\n    generar_clientes\(\)\r\n    generar_vehiculos\(\)\r\n    generar_plazas_parking\(\)\r\n    generar_reservas_y_pagos\(\)  \r\n    generar_incidencias\(\)\r\n    print\("Generación de datos completada"\)\r\n\r\nif __name__ == "__main__":\r\n    main\(\))>>
endobj

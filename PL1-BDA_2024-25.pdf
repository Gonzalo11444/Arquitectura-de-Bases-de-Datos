<</AP<</N 1112 0 R >>/DA(/Georgia 10 Tf 0 g)/DS 197 0 R /F 4/FT/Tx/Ff 41947136/MK<</BC[ 0 0 0]>>/P 65 0 R /RV(Reinicializamos los datos\r\nHacemos la consulta. SELECT * FROM productos WHERE stock = 100 OR precio = 1000;\r\nNos devuelve 1286 tuplas.\r\nSELECT heap_blks_read, heap_blks_hit FROM pg_statio_user_tables\r\nWHERE relname = 'productos';\r\nEmpleamos la consulta para saber qué indice ha leido los bloques, select * from pg_statio_all_indexes;\r\n\r\nheap_blks_read = 197196 y hit\(cache\) 1396.\r\nVemos que no se ha empleado ningún índice y se ha realizado una búsqueda secuencial, lo que es completamente lógico para este tipo de consulta.\r\n)/Rect[ 84.275002 33.859901 539.513 246.621]/Subtype/Widget/T(Text32)/Type/Annot/V(Reinicializamos los datos\r\nHacemos la consulta. SELECT * FROM productos WHERE stock = 100 OR precio = 1000;\r\nNos devuelve 1286 tuplas.\r\nSELECT heap_blks_read, heap_blks_hit FROM pg_statio_user_tables\r\nWHERE relname = 'productos';\r\nEmpleamos la consulta para saber qué indice ha leido los bloques, select * from pg_statio_all_indexes;\r\n\r\nheap_blks_read = 197196 y hit\(cache\) 1396.\r\nVemos que no se ha empleado ningún índice y se ha realizado una búsqueda secuencial, lo que es completamente lógico para este tipo de consulta.\r\n)>>
endobj

<</AP<</N 1110 0 R >>/DA(/Georgia 10 Tf 0 g)/DS 196 0 R /F 4/FT/Tx/Ff 41947136/MK<</BC[ 0 0 0]>>/P 65 0 R /RV(Reinicializamos los datos y hacemos la consulta.\r\nSELECT * FROM productos WHERE stock = 100 AND precio = 1000;\r\nEsto nos devuelve 0 tuplas, no existe.\r\nVemos los bloques leídos por la tabla\(aplicable a todas las cuestiones ya\) SELECT relname, heap_blks_read, heap_blks_hit FROM pg_statio_user_tables\r\nWHERE relname = 'productos';\r\nEmpleamos la consulta para saber qué indice ha leido los bloques, select * from pg_statio_all_indexes;\r\nAquí se ha usado 4 bloques de la caché, empleando el índice idx_stock_precio con heap_blks_hit || 2\r\n)/Rect[ 84.602402 282.789 539.84003 495.55099]/Subtype/Widget/T(Text31)/Type/Annot/V(Reinicializamos los datos y hacemos la consulta.\r\nSELECT * FROM productos WHERE stock = 100 AND precio = 1000;\r\nEsto nos devuelve 0 tuplas, no existe.\r\nVemos los bloques leídos por la tabla\(aplicable a todas las cuestiones ya\) SELECT relname, heap_blks_read, heap_blks_hit FROM pg_statio_user_tables\r\nWHERE relname = 'productos';\r\nEmpleamos la consulta para saber qué indice ha leido los bloques, select * from pg_statio_all_indexes;\r\nAquí se ha usado 4 bloques de la caché, empleando el índice idx_stock_precio con heap_blks_hit || 2\r\n)>>
